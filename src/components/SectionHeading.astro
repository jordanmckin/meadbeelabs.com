---
interface Props {
  index: string;
  title: string;
  description?: string;
  headingId?: string;
}

const { index, title, description, headingId } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="section-index">{index}</p>
    <h2 id={headingId}>{title}</h2>
  </div>
  {description && <p class="section-heading-copy">{description}</p>}
</div>
