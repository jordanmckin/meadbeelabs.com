---
interface Props {
  label?: string;
}

const { label = 'System topology · conceptual view' } = Astro.props;
---

<figure class="architecture">
  <figcaption class="architecture-label">
    <span>{label}</span>
    <span class="status-light">Routing</span>
  </figcaption>
  <div class="architecture-flow" role="img" aria-label="A director coordinates workers, plugins, and tools, which feed long-running Wiggum loops.">
    <div class="arch-node director">
      <span class="arch-node-code">ORCH-01</span>
      <strong>Director</strong>
      <span class="arch-port" aria-hidden="true"></span>
    </div>
    <div class="arch-connector split" aria-hidden="true"></div>
    <div class="arch-node workers"><span class="arch-node-code">EXEC</span><strong>Workers</strong></div>
    <div class="arch-node plugins"><span class="arch-node-code">EXT</span><strong>Plugins</strong></div>
    <div class="arch-node tools"><span class="arch-node-code">IO</span><strong>Tools</strong></div>
    <div class="arch-connector split" aria-hidden="true"></div>
    <div class="arch-node loops">
      <span class="arch-loop-ring" aria-hidden="true"></span>
      <span class="arch-node-code">ITERATE</span>
      <strong>Wiggum loops</strong>
    </div>
  </div>
  <div class="architecture-cycle" aria-hidden="true">
    <span>Plan</span><i></i><span>Create</span><i></i><span>Inspect</span><i></i><span>Improve</span>
  </div>
</figure>
